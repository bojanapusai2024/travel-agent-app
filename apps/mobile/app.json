{
  "name": "Travel Agent",
  "slug": "travel-agent",
  "version": "1.0.0",
  "orientation": "portrait",
  "icon": "./assets/icon.png",
  "userInterfaceStyle": "automatic",
  "splash": {
    "image": "./assets/splash.png",
    "resizeMode": "contain",
    "backgroundColor": "#0d1117"
  },
  "assetBundlePatterns": [
    "**/*"
  ],
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.travelagent.app",
    "infoPlist": {
      "NSLocationWhenInUseUsageDescription": "Travel Agent needs access to your location to track your travel progress and share with team members.",
      "NSLocationAlwaysAndWhenInUseUsageDescription": "Travel Agent needs access to your location to track your travel progress and share with team members."
    }
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#0d1117"
    },
    "package": "com.travelagent.app",
    "permissions": [
      "ACCESS_FINE_LOCATION",
      "ACCESS_COARSE_LOCATION",
      "ACCESS_BACKGROUND_LOCATION"
    ]
  },
  "web": {
    "favicon": "./assets/favicon.png"
  },
  "scheme": "travel-agent",
  "plugins": [
    "expo-location",
    "expo-notifications",
    "expo-secure-store"
  ],
  "extra": {
    "eas": {
      "projectId": "your-project-id"
    }
  }
}
