{
  "name": "travel-agent-app",
  "version": "1.0.0",
  "description": "A comprehensive, real-time travel planning and budget management platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @travel-agent/web dev",
    "dev:mobile": "pnpm --filter @travel-agent/mobile start",
    "dev:api": "pnpm --filter @travel-agent/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @travel-agent/web build",
    "build:api": "pnpm --filter @travel-agent/api build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "db:migrate": "cd apps/api && pnpm db:migrate",
    "db:seed": "cd apps/api && pnpm db:seed",
    "prepare": "echo 'Husky hooks ready'"
  },
  "keywords": [
    "travel",
    "budget",
    "planning",
    "real-time",
    "monorepo"
  ],
  "author": "BOJANAPU SAI PRANEETH",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  }
}
